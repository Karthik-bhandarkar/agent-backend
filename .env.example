# =================================================================
# Arogya — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to git — it is already in .gitignore.
# =================================================================

# -----------------------------------------------------------------
# 1. DATABASE — MongoDB Atlas connection string
# Get this from: MongoDB Atlas > Your Cluster > Connect > Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# -----------------------------------------------------------------
MONGODB_URI=

# Alternative alias used by some modules (set to same value as MONGODB_URI)
MONGODB_URL=

# -----------------------------------------------------------------
# 2. AI ENGINE — Groq API key for LLM inference (Llama-3.1-8B-Instant)
# Get this from: https://console.groq.com > API Keys
# Starts with: gsk_
# -----------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------
# 3. JWT — Authentication token signing key
# Use any long random string (e.g. generate with: openssl rand -hex 32)
# Keep this secret — anyone with this key can forge auth tokens.
# -----------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------
# 4. GOOGLE OAUTH (optional — not yet active in production)
# If you want to enable Google login, add credentials from:
# Google Cloud Console > APIs & Services > OAuth 2.0 Client IDs
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -----------------------------------------------------------------
# 5. FRONTEND — Base URL of the React app (used for OAuth redirects)
# Local dev:   http://localhost:5173
# Production:  https://your-frontend.netlify.app (or Render URL)
# -----------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173

# -----------------------------------------------------------------
# 6. PYTHON RUNTIME — for Render deployment
# -----------------------------------------------------------------
PYTHON_VERSION=3.10.12
